[Unit]
Description=Decrypt the private files of app %i
# Assert*, so a host without the key fails the start job, naming the key, and Requires= keeps
# the app from starting against an empty private directory. LoadCredential= below fails it
# too, with error code 243 alone.
AssertPathExists={{ systemd_app_private_key_file }}

[Service]
Type=oneshot
RemainAfterExit=yes
# ramfs, this unit's processes only, and LoadCredentialEncrypted= later is a one-word change.
LoadCredential=age-key:{{ systemd_app_private_key_file }}
# systemd destroys this when the unit stops, so plaintext never outlives it. Only the innermost
# directory goes, so it is the app's own and the helper makes private/ inside it.
RuntimeDirectory=app/%i
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 {{ systemd_app_private_helper }} %i

{# Each app's drop-in pulls its instance in with Requires=, which is the unit's whole activation:
   nothing to enable, and nothing left behind when an app stops shipping private files. #}
