[Unit]
Description=Decrypt the private files of app %i
# No Condition*: a skipped unit still satisfies Requires=, so a host without the key would
# start the app against an empty private directory instead of not starting it.

[Service]
Type=oneshot
RemainAfterExit=yes
# ramfs, this unit's processes only, and LoadCredentialEncrypted= later is a one-word change.
# A missing file fails the unit here, before the helper runs.
LoadCredential=age-key:{{ systemd_app_private_key_file }}
# systemd destroys this when the unit stops, so plaintext never outlives it. The helper reads
# the path from $RUNTIME_DIRECTORY.
RuntimeDirectory=app/%i/private
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 {{ systemd_app_private_helper }} %i

{# No [Install]: each app's drop-in pulls its instance in with Requires=, so there is none to
   enable and none left behind when an app stops shipping private files. #}
