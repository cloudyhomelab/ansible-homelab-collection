[Unit]
Description={{ systemd_app_description | default(systemd_app_name ~ ' container') }}
After=network-online.target
Wants=network-online.target

[Container]
Image={{ systemd_app_image }}
ContainerName={{ systemd_app_name }}
AutoUpdate=registry
Network={{ systemd_app_network }}
{# Quoting and escaping live in systemd_env_lines, where they are tested; see
   `ansible-doc -t filter binarycodes.homelab.systemd_env_lines` for the rules they follow. #}
{% for line in systemd_app_env | binarycodes.homelab.systemd_env_lines %}
{{ line }}
{% endfor %}
{% for name in systemd_app_secret_values | sort %}
Secret={{ name }},type=env,target={{ name | upper | replace('-', '_') }}
{% endfor %}
{% for vol in systemd_app_volumes %}
Volume={{ vol }}
{% endfor %}
{% for pub in systemd_app_publish_ports %}
PublishPort={{ pub }}
{% endfor %}
{% for line in systemd_app_container_options %}
{{ line }}
{% endfor %}
{% if systemd_app_health_cmd | length > 0 %}
HealthCmd={{ systemd_app_health_cmd }}
HealthInterval={{ systemd_app_health_interval }}
HealthRetries={{ systemd_app_health_retries }}
HealthStartPeriod={{ systemd_app_health_start_period }}
# Withholds "started" until the first probe passes, so podman auto-update sees a bad
# image as a failed start and reverts it.
Notify=healthy
{% endif %}

[Service]
Restart=always
{% if systemd_app_health_cmd | length > 0 %}
# Notify=healthy above makes this the deadline for the first passing probe.
TimeoutStartSec={{ systemd_app_start_timeout }}
{% endif %}
{% for line in systemd_app_service_options %}
{{ line }}
{% endfor %}

[Install]
WantedBy=multi-user.target default.target
